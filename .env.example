# Optional. Without it Cauce uses its built-in deterministic Spanish parser (free).
# Setting it enables Claude for message understanding — this is billed API usage.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5; claude-haiku-5-5 is the low-cost option)
CAUCE_AI_MODEL=
# Public base URL used in employee response links
CAUCE_BASE_URL=http://localhost:3000
# SQLite file location
CAUCE_DB_PATH=./data/cauce.db
